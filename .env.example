# ==============================================================================
# PR Outreach Automator (Kxrn Edition) - Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Notion CRM Configuration
# ------------------------------------------------------------------------------
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_api_key_here
# The ID of your Notion Database (found in the database URL before '?v=')
NOTION_DATABASE_ID=your_notion_database_id_here

# ------------------------------------------------------------------------------
# 2. Sender Profile & Email Engine
# ------------------------------------------------------------------------------
SENDER_NAME=Kxrn Gupta
SENDER_EMAIL=chitesh.gupta@gmail.com

# Choose provider: 'smtp', 'gmail_api', or 'resend'
EMAIL_PROVIDER=smtp

# --- If EMAIL_PROVIDER = smtp ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chitesh.gupta@gmail.com
# Use a 16-character Google App Password (not your normal Gmail password)
SMTP_PASSWORD=your_gmail_app_password_here

# --- If EMAIL_PROVIDER = gmail_api ---
GMAIL_CREDENTIALS_FILE=config/credentials.json
GMAIL_TOKEN_FILE=config/token.json

# --- If EMAIL_PROVIDER = resend ---
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 3. IMAP Settings (Reply Detection)
# ------------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=chitesh.gupta@gmail.com
IMAP_PASSWORD=your_gmail_app_password_here
IMAP_CHECK_FOLDER=INBOX

# ------------------------------------------------------------------------------
# 4. Open Tracking Server (Vercel / FastAPI)
# ------------------------------------------------------------------------------
# Public URL where the tracking pixel is hosted (no trailing slash)
# e.g., https://kxrn-pr-tracker.vercel.app or http://localhost:8000 for local dev
TRACKING_SERVER_URL=https://kxrn-pr-tracker.vercel.app

# ------------------------------------------------------------------------------
# 5. Anti-Spam Throttling & Human Warmup Rules
# ------------------------------------------------------------------------------
# Delay range between consecutive emails (in seconds) - e.g. 180s (3m) to 420s (7m)
MIN_DELAY_SECONDS=180
MAX_DELAY_SECONDS=420

# Max emails allowed per day (warm-up recommendation: 10-15 early, max 40-50)
DAILY_SEND_LIMIT=30

# Number of days to wait before sending an automated follow-up
FOLLOW_UP_AFTER_DAYS=4

# ------------------------------------------------------------------------------
# 6. Telegram Instant Alerts (Optional)
# ------------------------------------------------------------------------------
# Ping you immediately when a journalist opens or replies!
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
